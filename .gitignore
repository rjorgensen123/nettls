# ── Rust / Cargo ──
/target/
debug/
**/*.rs.bk
*.pdb
# Cargo.lock is committed on purpose: a security-sensitive crate wants reproducible builds

# ── Python (the binding in nettls-py/) ──
# .pyc files are machine-specific (cpython-312, pytest-9.1.1) and were once
# COMMITTED here — which put them in `cargo package`, and so into the published
# crate. Bytecode from one developer's machine has no place in the repository.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
# What `maturin develop` and `maturin build` leave behind.
*.so
/nettls-py/target/

# ── Editor / OS ──
/.idea/
/.vscode/
*.swp
*~
.DS_Store
Thumbs.db
